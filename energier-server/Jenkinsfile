// ============================================================================
//  EnergIR API — Spring Boot
//
//  Jenkins declarative pipeline. It:
//    1. checks out the repo
//    2. rsyncs energier-server/ to /opt/energir
//    3. builds the executable jar
//    4. restarts the systemd service
//    5. smoke-tests the API port
//
//  One-time server setup: deploy/setup-server.sh
//  Full walkthrough:      doc/JENKINS.md
// ============================================================================

pipeline {
  // The deploy target is the host itself (/opt/energir + systemd), so the build
  // must run on a host agent — not on the built-in node, which is a container
  // where /opt is read-only and systemctl does not exist.
  agent { label 'host-deploy' }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    APP_DIR = '/opt/energir'
    // The Gradle project lives in a subfolder of the repo.
    PROJECT_DIR = 'energier-server'
    // The agent host ships JDK 26 as its default `java`; Gradle 8.7 cannot run
    // on that, so builds are pinned to the JDK 21 installed alongside it.
    JAVA_HOME = '/usr/lib/jvm/java-21-openjdk'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Tool check') {
      steps {
        dir(env.PROJECT_DIR) {
          sh '''
            set -eu
            chmod +x gradlew
            "$JAVA_HOME/bin/java" -version
            ./gradlew --version | sed -n '1,6p'
          '''
        }
      }
    }

    stage('Sync sources') {
      steps {
        sh '''
          set -eu
          mkdir -p "$APP_DIR"
          # -rlptD is -a without -o/-g: the agent runs as `jenkins`, which cannot
          # chgrp a directory owned by `energir` (rsync then exits 23). Ownership
          # is already right on the destination; the group gets write via g+rwX.
          rsync -rlptD --delete \
            --exclude '.git' \
            --exclude 'build' \
            --exclude '.gradle' \
            --exclude '.idea' \
            "$PROJECT_DIR/" "$APP_DIR/"
        '''
      }
    }

    stage('Build jar') {
      steps {
        // `cd` instead of dir(APP_DIR): dir() makes /opt/energir the workspace,
        // and the sh step then needs a sibling control dir /opt/energir@tmp in
        // root-owned /opt (AccessDeniedException). The workspace stays under
        // /home/jenkins; only the build's working directory moves.
        sh 'cd "$APP_DIR" && ./gradlew clean bootJar -x test --console=plain'
      }
    }

    stage('Restart API') {
      steps {
        sh 'sudo systemctl restart energir-server'
        // Keep this command exactly as allowed in /etc/sudoers.d/jenkins-deploy.
        sh 'sudo systemctl status energir-server || true'
      }
    }

    stage('Smoke test') {
      steps {
        sh '''
          set -eu
          # The port lives in /etc/volts/energir.env; read it back from systemd
          # so changing SERVER_PORT there is enough.
          port=$(systemctl show energir-server -p Environment --value \
            | tr ' ' '\\n' | sed -n 's/^SERVER_PORT=//p' | tail -n 1)
          port=${port:-8080}
          echo "Smoke-testing http://127.0.0.1:${port}/api/v1/devices"
          for i in $(seq 1 20); do
            code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${port}/api/v1/devices" || true)
            if [ "$code" = "200" ] || [ "$code" = "401" ] || [ "$code" = "403" ]; then
              echo "API is up (HTTP $code)"
              exit 0
            fi
            sleep 2
          done
          echo "API did not become healthy in time" >&2
          exit 1
        '''
      }
    }
  }

  post {
    success { echo "Deployed ${env.BUILD_TAG} to ${env.APP_DIR}" }
    failure { echo "Deployment failed — check the logs above." }
  }
}
