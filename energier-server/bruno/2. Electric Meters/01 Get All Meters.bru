meta {
  name: Get All Meters
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/meters
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200)
  })

  test("returns an array of meters", function() {
    expect(res.getBody()).to.be.an("array")
  })
}
