meta {
  name: Authenticate
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/vi/auth/authenticate
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody()
  if (body && body.access_token) {
    bru.setEnvVar("token", body.access_token)
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200)
  })

  test("returns access_token and role", function() {
    expect(res.getBody().access_token).to.be.a("string")
    expect(res.getBody().role).to.be.a("string")
  })
}
